# Architect 2.0 — environment variables
# Copy to .env.local for local dev (never commit it). On Vercel, add the same keys under
# Project → Settings → Environment Variables. Validated at runtime by lib/env.ts.

# ── Supabase (public: safe in the browser, protected by RLS) ─────────────────────────────
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only: NEVER prefix with NEXT_PUBLIC_) ────────────────────────────────
# Supabase → Project Settings → API → service_role key. Bypasses RLS; trusted server jobs only.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Connection string (Session pooler, port 5432). Used by Memori + scripts.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── LLM providers (server-only; at least one is required) ────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://console.groq.com/keys (fast open-weight models: GPT-OSS, Qwen)
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Per-user daily token cap across all projects (protects shared demo keys). Default 200000.
DAILY_TOKEN_CAP=200000
# Lower cap for demo-mode guests (anonymous sign-in). Default 30000.
DEMO_TOKEN_CAP=30000

# ── Memory (optional) ─────────────────────────────────────────────────────────────────────
# Memori Cloud key (https://memorilabs.ai). Only needed if we use Memori Cloud instead of
# our own Postgres — see docs/memori-spike.md.
MEMORI_API_KEY=

# ── GitHub push (server-only) ─────────────────────────────────────────────────────────────
# Encrypts users' GitHub tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
GITHUB_TOKEN_KEY=
